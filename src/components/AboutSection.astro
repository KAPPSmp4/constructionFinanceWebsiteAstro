---

<div id="about-section">
    <div class="content">
        <h1>Über mich</h1>
    </div>
    <div class="image-container">
        <img src="public/icons/hero.jpeg" alt="" class="foreground-image" />
    </div>
</div>

<style>
    #about-section {
        min-height: 100vh;

        display: flex;
        justify-content: center;
        align-items: center;
    }

    @media (max-width: 768px) {
        .about-section {
            flex-direction: column;
            gap: 3rem;
            padding: 3rem 8%;
        }

        .image-container {
            width: min(75%, 441px);
        }
    }

    .image-container {
        position: relative;

        position: relative;
        width: min(40vw, 441px);
        aspect-ratio: 441 / 500;
        flex-shrink: 0;
    }

    .image-container > div {
        position: absolute;
        inset: 0;
    }

    .foreground-image {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: contain;

        position: relative;
        z-index: 100;
    }
</style>
