---
import type { CollectionEntry } from "astro:content";
import { render } from "astro:content";

interface Props {
    review: CollectionEntry<"reviews">;
}

const { review } = Astro.props;
const { Content } = await render(review);
---

<div class="review-card">
    <div class="heading">
        <img src={review.data.profile_picture} alt="profile picture" />

        <div class="header-info">
            <p class="author">{review.data.author}</p>
            <p class="date">{review.data.date}</p>
        </div>

        <div class="google">
            <img src="public/icons/google_logo.webp" alt="google logo" />
        </div>
    </div>

    <div class="rating">
        <img src="public/icons/star.png" alt="star" />
        <img src="public/icons/star.png" alt="star" />
        <img src="public/icons/star.png" alt="star" />
        <img src="public/icons/star.png" alt="star" />
        <img src="public/icons/star.png" alt="star" />
    </div>

    <div class="content-section">
        <div class="content">
            <Content />
        </div>

        <button class="read-more">Mehr</button>
    </div>
</div>

<style>
    .review-card {
        width: 300px;
        background-color: var(--white);
        height: 200px;
        box-sizing: border-box;

        border: 0;
        border-radius: 20px;
        padding: 18px;

        overflow: hidden;
        text-overflow: ellipsis;
        transition: height 0.4s ease;
    }

    .review-card.expanded {
        height: var(--expanded-height);
    }

    .heading {
        display: flex;
    }

    .header-info {
        flex: 1;
        height: 50px;
        padding-left: 8px;
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

    .author {
        font-size: large;
        font-weight: 600;
    }

    .date {
        color: grey;
    }

    .rating {
        display: flex;
        gap: 2px;
        padding: 8px 0px;
    }

    .rating img {
        width: auto;
        height: 16px;
    }

    .content {
        max-height: 4.5em; /* 3 lines */
        overflow: hidden;
        transition: max-height 0.4s ease;

        display: -webkit-box;
        -webkit-box-orient: vertical;
        -webkit-line-clamp: 3;
        line-clamp: 3;
    }

    .content.expanded {
        max-height: var(--full-height);
        display: block;
        -webkit-line-clamp: unset;
        line-clamp: unset;
    }

    .read-more {
        display: none;
        cursor: pointer;
        margin-top: 8px;
        color: grey;
        background-color: var(--white);
    }

    img {
        width: auto;
        height: 48px;
    }

    .google {
        height: 38px;
    }

    .google img {
        height: 100%;
    }
</style>

<script>
    import "./ReviewCard.js";
</script>
