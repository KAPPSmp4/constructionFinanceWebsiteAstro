---
import { getCollection, type CollectionEntry } from "astro:content";
import ReviewCard from "./ReviewCard.astro";

const reviews: CollectionEntry<"reviews">[] =
    await getCollection("reviews");
---

<div class="reviewSection">

    <h1>HIER SIND REVIEWS</h1>

    <div class="scroller">
        <ul class="review-list scroller__inner">
            {reviews.map(review => (<li><ReviewCard review={review}/></li>))}
        </ul> 
    </div>
        
</div>

<style>
    .reviewSection{
        background-color: var(--blue);

        display: flex;
        flex-direction: column;
        justify-items: center;
        align-items: center;
    }

    h1 {
        color: var(--white);
        margin: 20px;
    }

    .scroller {
        max-width: 90%;
        outline: 2px solid red;
    }

    .scroller__inner {
        padding-block: 2rem;
        display: flex;
        flex-wrap: wrap;

        justify-content: center;
    }

    .scroller[data-animated="true"] {
        overflow: hidden;
        -webkit-mask: linear-gradient(90deg, transparent, white 20%, white 80%, transparent);
        mask: linear-gradient(90deg, transparent, white 20%, white 80%, transparent);
    }

    .scroller[data-animated="true"] .scroller__inner {
        width: fit-content;
        flex-wrap: nowrap;
        animation: scroll var(--_animation-duration, 90s) var(--_animation-direction, forwards) linear infinite;
    }

    @keyframes scroll {
        to {
            transform: translate(calc(-50% - 0.75rem));
        }
    }

    .review-list {
        gap: 1.5rem;
        margin: 0;
        padding-inline: 0;
        list-style: none;
    }
</style>

<script>
    import "./ReviewCarousel.js";
</script>