---

---

<div class="heroSection">
    <div class="heading">
        <h1>BLIBLALBO</h1>
        <p>ich sage wie cool dieser baufinanzer ist</p>
    </div>

    <div class="heroImage">
        <img src="public/icons/hero.jpeg" alt="" class="foreground-image" />
        <div class="heroBack3"></div>
        <div class="heroBack2"></div>
        <div class="heroBack1"></div>
    </div>
</div>

<style>

    .heroSection {
        width: 100%;
        min-height: 70vh;
        padding: 3rem 5%;
        box-sizing: border-box;

        background-color: var(--white);

        display: flex;
        justify-content: center;
        align-items: center;
        gap: clamp(2rem, 8vw, 10rem);
    }

    .heroSection h1 {
        margin: 0;
        font-size: clamp(2rem, 5vw, 70px);
    }

    .heading {
        color: var(--black);
        min-width: 0;
    }

    @media (max-width: 768px) {
        .heroSection {
            flex-direction: column;
            gap: 3rem;
            padding: 3rem 8%;
        }

        .heroImage {
            width: min(75%, 441px);
        }
    }

    .heroImage {
        position: relative;

        position: relative;
        width: min(40vw, 441px);
        aspect-ratio: 441 / 500;
        flex-shrink: 0;
    }

    .heroImage > div {
        position: absolute;
        inset: 0;
    }

    .heroBack1 {
        background-color: var(--blue);
        transform: translate(10px, -10px);
        z-index: 1;
    }

    .heroBack2 {
        background-color: var(--blue);
        transform: translate(20px, -20px);
        z-index: 2;
    }

    .heroBack3 {
        background-color: var(--blue);
        transform: translate(30px, -30px);
        z-index: 3;
    }

    .foreground-image {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: contain;

        position: relative;
        z-index: 100;
    }
</style>
