<div class="heroSection">
    <div class="heading">
        <h1>BLIBLALBO</h1>
        <p>ich sage wie cool dieser baufinanzer ist</p>
    </div>

    <div class="heroImage">
        <img src="public/icons/hero.jpeg" alt="" class="foreground-image" />
        <div class="heroBack3"></div>
        <div class="heroBack2"></div>
        <div class="heroBack1"></div>
    </div>
</div>

<style>
    .heroSection {
        width: 100%;
        height: 70vh;
        background-color: var(--white);

        display: flex;
        justify-content: center;
        align-items: center;

        gap: 10rem;
    }

    .heading {
        color: var(--black);
    }

    .heroSection h1 {
        margin: 0px;
        font-size: 70px;
    }

    .heroImage {
        position: relative;
    }

    .heroBack1 {
        height: 500px;
        width: 441px;

        background-color: #c5e1ef;

        position: absolute;
        z-index: 3;
        top: -10;
        left: 10;
    }

    .heroBack2 {
        height: 500px;
        width: 441px;

        background-color: var(--blue);

        position: absolute;
        z-index: 2;
        top: -20;
        left: 20;
    }

    .heroBack3 {
        height: 500px;
        width: 441px;

        background-color: var(--blue);

        position: absolute;
        z-index: 1;
        top: -30;
        left: 30;
        z-index: 2;
    }

    .foreground-image {
        max-height: 500px;
        position: relative;
        z-index: 100;

        display: block;
    }
</style>
