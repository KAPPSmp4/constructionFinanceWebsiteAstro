---

<div class="hero-section">
    <div class="heading">
        <h1>Raus aus der Miete und rein ins Eigenheim !</h1>
        <p>Baufinanzierung in Riegelsberg</p>
        <div class="call-to-action">
            <a href="#lead-section" class="button">TESSTT</a>
            <a href="#kontakt-section" class="button"
                >Kontaktieren Sie mich persönlich</a
            >
        </div>
    </div>

    <div class="hero-image">
        <img src="public/icons/hero.jpeg" alt="" class="foreground-image" />
    </div>
</div>

<style>
    .hero-section {
        width: 100%;
        min-height: 90vh;
        padding: 3rem 5%;
        box-sizing: border-box;

        background-color: var(--white);

        display: flex;
        justify-content: center;
        align-items: center;
        gap: clamp(2rem, 8vw, 10rem);
    }

    .hero-section h1 {
        margin: 0;
        font-size: clamp(2rem, 5vw, 70px);
    }

    .heading {
        color: var(--black);
        min-width: 0;
    }

    .call-to-action {
        display: flex;
        gap: 1rem;
    }

    @media (max-width: 768px) {
        .hero-section {
            flex-direction: column;
            gap: 3rem;
            padding: 3rem 8%;
        }

        .hero-image {
            width: min(75%, 441px);
        }
    }

    .hero-image {
        position: relative;

        position: relative;
        width: min(40vw, 441px);
        aspect-ratio: 441 / 500;
        flex-shrink: 0;
    }

    .hero-image > div {
        position: absolute;
        inset: 0;
    }

    .foreground-image {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: contain;

        position: relative;
        z-index: 100;
    }
</style>
